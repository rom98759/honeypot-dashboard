# Copy to .env (chmod 600) and adjust. Read by docker compose.

# Real sshd port, shown on the Correlation page. Must match host.env.
SSHD_PORT=
# Host port published for Cowrie. Leave 22 unless you know why.
COWRIE_PORT=22
COWRIE_IMAGE=cowrie/cowrie:latest
# Subnet of the honeypot network. Must match HONEYPOT_SUBNET in host.env.
HONEYPOT_SUBNET=172.21.0.0/16

# Docker network of your reverse proxy (created by the proxy, not by this project).
PROXY_NETWORK=nginx-proxy-network

# Volume names. Override only to reuse volumes from an existing install.
COWRIE_ETC_VOLUME=honeypot-cowrie-etc
COWRIE_VAR_VOLUME=honeypot-cowrie-var
DASHBOARD_DATA_VOLUME=honeypot-dashboard-data

# GeoLite2 databases directory (filled by geoip-update.sh).
GEOIP_DIR=./geoip
# GID of the group owning /var/log/honeypot-export (adm = 4 on Debian/Ubuntu).
ADM_GID=4

# Ban/unban from the dashboard (needs FBAN_ENABLED=1 in host.env too). 0 = read-only.
FBAN_ENABLED=0
# Your own IPs/CIDRs, comma-separated: never bannable from the dashboard.
ADMIN_IPS=
# Optional AbuseIPDB reputation lookups. Empty = disabled.
ABUSEIPDB_API_KEY=
