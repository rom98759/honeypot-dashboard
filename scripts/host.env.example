# Host-side configuration, read by scripts/install-host.sh and the scripts it installs.
# Install as /etc/honeypot-dashboard/host.env, owned by root, chmod 600 (holds the MaxMind key).

# Port your REAL sshd listens on. Must NOT be 22 (Cowrie takes it). See docs/install.md, step 0.
SSHD_PORT=50022

# Absolute path of this repository on the host (GeoIP databases go to $REPO_DIR/geoip).
# Optional: the installer fills it with the clone it runs from.
REPO_DIR=/opt/honeypot-dashboard

# Must equal HONEYPOT_SUBNET in the repo's .env.
HONEYPOT_SUBNET=172.21.0.0/16

# Internet-facing interface. Empty = interface of the default route.
WAN_IFACE=

# 1 = published ports 80/443 only reachable from Cloudflare (only if your DNS is proxied by Cloudflare).
CLOUDFLARE_ONLY=0
# Space-separated published container ports to drop from the Internet (e.g. "81" for a proxy admin UI).
BLOCK_PORTS=

# 1 = install the worker that lets the dashboard ban/unban in fail2ban. Set FBAN_ENABLED=1 in .env too.
FBAN_ENABLED=0

# Free MaxMind GeoLite2 account: https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
