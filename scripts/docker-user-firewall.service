[Unit]
Description=Rebuild the iptables DOCKER-USER chain (honeypot egress block, optional WAN filters)
After=docker.service ufw.service
Requires=docker.service
Wants=ufw.service
PartOf=docker.service

[Service]
# No RemainAfterExit=yes: the timer re-triggers this unit. With it, once "active
# (exited)" every later `systemctl start` (each timer tick) is a no-op until the unit
# is stopped, so the rules would never be re-applied after the first boot.
Type=oneshot
ExecStart=/usr/local/sbin/docker-user-firewall.sh

[Install]
WantedBy=multi-user.target
